{
  "name": "postline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply postline --local",
    "db:migrate:remote": "wrangler d1 migrations apply postline --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/node": "22.18.0",
    "typescript": "6.0.3",
    "wrangler": "4.148.0"
  }
}
